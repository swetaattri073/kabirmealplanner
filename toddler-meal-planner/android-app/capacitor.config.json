{
  "appId": "com.littlebowl.app",
  "appName": "LittleBowl",
  "webDir": "www",
  "server": {
    "url": "http://littlebowl.in/home",
    "cleartext": true,
    "allowNavigation": [
      "littlebowl.in",
      "*.littlebowl.in",
      "http://littlebowl.in",
      "http://littlebowl.in/*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#fffaf0",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#6b8f3c",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_littlebowl",
      "iconColor": "#6b8f3c",
      "sound": "default"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#fffaf0",
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#fffaf0",
    "preferredContentMode": "mobile",
    "scrollEnabled": true,
    "allowsLinkPreview": false,
    "limitsNavigationsToAppBoundDomains": true
  }
}
