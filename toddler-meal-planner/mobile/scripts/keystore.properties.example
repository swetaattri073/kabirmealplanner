# Copy to credentials/keystore.properties (survives expo prebuild --clean).
# Use the SAME upload keystore as your existing Play listing (com.littlebowl.app).
#
# storeFile path is relative to android/app/

storeFile=../../credentials/littlebowl-upload-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=littlebowl
keyPassword=YOUR_KEY_PASSWORD
